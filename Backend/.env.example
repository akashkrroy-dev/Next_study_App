# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017/nexstudy

# Email (OTP / password reset)
EMAIL_USER=
EMAIL_PASS=

# JWT secrets (generate long random strings)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
RESET_PASSWORD_TOKEN_SECRET=

# Allowed frontend origins (comma-separated). In production, since the frontend
# is served by this same backend on Render, leave this EMPTY — the frontend uses
# relative /api URLs and same-site cookies. Set it only if you serve the frontend
# from a different origin (e.g. a custom subdomain).
CLIENT_ORIGIN=

# Redis — leave REDIS_TLS=false for a plain-TCP free Redis
# (Upstash's free tier provides a TLS-only endpoint; if you use that,
# set REDIS_TLS=true and REDIS_PORT to the TLS port).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false